{
  "name": "liquidationport-api",
  "version": "1.0.0",
  "description": "NestJS Backend for Liquidationport",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
