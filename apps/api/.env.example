PORT=4000
FRONTEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Public JSON from https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json.
# Refresh this value before rotating Supabase asymmetric signing keys.
SUPABASE_JWKS={"keys":[]}
SUPABASE_DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Supabase Storage S3-compatible credentials ---
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_STORAGE_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_STORAGE_SECRET_ACCESS_KEY=your-supabase-s3-secret-access-key

# --- Cloudflare R2 Storage (Public Media) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ecommerce-product-images
# During local dev, proxy R2 images through NestJS to avoid CORS.
# In production: set this to your R2 public CDN URL e.g. https://media.yourdomain.com
R2_PUBLIC_DOMAIN=http://localhost:4000/api/v1/shop/media
