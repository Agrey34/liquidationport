# ============================================================
# LIQUIDATIONPORT — MONOREPO .gitignore
# Covers: root, apps/web (Next.js), apps/api (NestJS/Prisma),
#         libs/shared, and common tooling
# ============================================================

# ================================
# !! MOST IMPORTANT — NEVER COMMIT
# ================================

# All node_modules everywhere in the monorepo
node_modules/
**/node_modules/

# Next.js build output & cache (ALL locations)
.next/
**/.next/
out/
**/out/

# NestJS / TypeScript build output
dist/
**/dist/
build/
**/build/

# ================================
# Environment Variables (SECURITY)
# ================================
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
!.env.example
!.env.*.example

# ================================
# Prisma Generated Client & Engines
# ================================
apps/api/src/generated/
apps/api/prisma/generated/
apps/api/node_modules/.prisma/
apps/api/node_modules

# ================================
# TypeScript Build Info
# ================================
*.tsbuildinfo
**/*.tsbuildinfo

# ================================
# Package Manager Caches
# ================================
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ================================
# Turbo / Monorepo Build Cache
# ================================
.turbo/
.cache/
**/.turbo/
**/.cache/

# ================================
# Vercel / Deployment
# ================================
.vercel
**/.vercel
.netlify

# ================================
# Testing & Coverage
# ================================
coverage/
**/coverage/
.nyc_output/
*.lcov
htmlcov/
.coverage

# ================================
# Editors & IDEs
# ================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ================================
# OS Files
# ================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ================================
# Security / Credentials
# ================================
*.pem
*.key
*.cert
*.p12
*.pfx
serviceAccountKey.json

# ================================
# Misc
# ================================
*.tmp
*.swp
logs/
