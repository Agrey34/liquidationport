# ============================================================
# LIQUIDATIONPORT — MONOREPO .gitignore
# Covers: root, apps/web (Next.js), apps/api (NestJS/Prisma),
#         libs/shared, and common tooling
# ============================================================

# ================================
# !! NEVER COMMIT: Secrets & Env Files
# ================================
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
*.env
*.env.*
!.env.example
!.env.*.example

# Credentials & Key Files
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*serviceAccount*.json
*service_account*.json
credentials.json
secrets.json
*.secret
*.secrets
*.cred
*.credentials
id_rsa*
id_ed25519*
.mcp.json

# ================================
# Scratch, Benchmark & Manual DB Migration Scripts
# ================================
scratch/
**/scratch/
scratch-*
*.scratch.*
apps/api/apply-*.js
apps/api/apply-*.ts
apps/api/benchmark-*.js
apps/api/benchmark-*.ts
apps/api/create-*.js
apps/api/create-*.ts
apps/api/update-*.js
apps/api/update-*.ts
apps/api/scratch-*.js
apps/api/scratch-*.ts
apps/api/enable_rls.sql
apps/api/*.sql
*.sql
*.ps1
test-*.js
test-*.ts

# ================================
# Dependency Directories
# ================================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ================================
# Build Outputs & Caches
# ================================
# Next.js
.next/
**/.next/
out/
**/out/

# NestJS / TypeScript
dist/
**/dist/
build/
**/build/
*.tsbuildinfo
**/*.tsbuildinfo

# Turbo / Monorepo
.turbo/
.cache/
**/.turbo/
**/.cache/

# ================================
# Prisma Generated Client & Engines
# ================================
apps/api/src/generated/
apps/api/prisma/generated/
apps/api/node_modules/.prisma/
apps/api/node_modules

# ================================
# Testing & Coverage Reports
# ================================
coverage/
**/coverage/
.nyc_output/
*.lcov
htmlcov/
.coverage
test-results/
playwright-report/
blob-report/

# ================================
# Logs & Debugging
# ================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================================
# Deployment Artifacts
# ================================
.vercel
**/.vercel
.netlify

# ================================
# Editors & IDE Configurations
# ================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ================================
# OS & System Files
# ================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
