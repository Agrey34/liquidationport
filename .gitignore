# ============================================================
# LIQUIDATIONPORT — MONOREPO .gitignore
# Covers: root, apps/web (Next.js), apps/api (NestJS/Prisma),
#         libs/shared, and common tooling
# ============================================================

# ================================
# Environment Variables (SECURITY — NEVER COMMIT)
# ================================
.env
.env.local
.env.*.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*
!.env.example
!.env.*.example

# ================================
# Node / Package Managers
# ================================
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================================
# Next.js (apps/web)
# ================================
.next/
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
apps/web/.vercel

# ================================
# NestJS Build Output (apps/api)
# ================================
apps/api/dist/

# ================================
# Prisma Generated Client (apps/api)
# Keep: schema.prisma, migrations/
# Ignore: generated client & binary engines
# ================================
apps/api/node_modules/.prisma/
apps/api/src/generated/
apps/api/prisma/generated/
apps/api/**/*.d.ts.map

# ================================
# TypeScript Build Info
# ================================
*.tsbuildinfo
apps/web/.next/cache/.tsbuildinfo

# ================================
# Turbo / Monorepo Build Cache
# ================================
.turbo/
.cache/
apps/web/.next/cache/

# ================================
# Testing & Coverage
# ================================
coverage/
apps/api/coverage/
apps/web/coverage/
libs/shared/coverage/
.nyc_output/
*.lcov
htmlcov/
.coverage

# ================================
# Logs & Temp Files
# ================================
*.log
*.tmp
*.swp
logs/
apps/api/logs/

# ================================
# Editors & IDEs
# ================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ================================
# System Files
# ================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ================================
# Security / Credentials
# ================================
*.pem
*.key
*.cert
*.p12
*.pfx
serviceAccountKey.json

# ================================
# Misc Build & Deploy Artifacts
# ================================
.vercel
.netlify
dist/
build/
out/

