# ===================================================
# Monorepo Root .gitignore
# ===================================================

# Dependencies (all levels)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
coverage/
.nyc_output/

# Next.js build outputs
**/.next/
**/out/

# NestJS / general build outputs
**/dist/
**/build/

# Environment variables — SECURITY: NEVER commit these
.env
.env.*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
*.pem

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/settings.json
.idea/

# Misc
*.local
